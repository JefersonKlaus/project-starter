# ============================================================================
# Environment variables of the portal — the single place to configure the app.
# All values are exposed to the browser (VITE_ prefix): do not put secrets here.
# Restart `npm run dev` after changing this file.
# ============================================================================

# --- Amazon Cognito (login) -------------------------------------------------
# User Pool app client ID (no client secret; USER_PASSWORD_AUTH + REFRESH_TOKEN_AUTH enabled).
VITE_COGNITO_CLIENT_ID=
# Region of the User Pool, e.g. us-east-1
VITE_COGNITO_REGION=us-east-1

# --- Architecture generation (WebSocket API) --------------------------------
# API id of the generation WebSocket API (region is fixed: us-east-2).
# Final URL: wss://<VITE_WS_API_ID>.execute-api.us-east-2.amazonaws.com/<VITE_WS_STAGE>?<VITE_WS_AUTH_PARAM>=<jwt>
VITE_WS_API_ID=
# Stage of the WebSocket API.
VITE_WS_STAGE=dev
# Query-string parameter that carries the Cognito JWT on $connect.
VITE_WS_AUTH_PARAM=token
# Which Cognito token to send on $connect: access or id.
VITE_WS_AUTH_TOKEN=access
# Seconds between keepalive messages (0 disables).
VITE_WS_KEEPALIVE_SECONDS=240
# `action` of the keepalive message.
VITE_WS_KEEPALIVE_ACTION=ping

# --- Backend REST API (settings: Git provider connection) -------------------
# Base URL of the API Gateway with the Cognito authorizer, e.g.
# https://abc123.execute-api.us-east-2.amazonaws.com/dev
VITE_API_BASE_URL=
